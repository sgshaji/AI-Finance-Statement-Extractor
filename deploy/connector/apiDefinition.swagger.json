{
  "swagger": "2.0",
  "info": {
    "title": "Financial Statement Extractor",
    "description": "Extracts financial statements from uploaded PDF reports with HITL review support.",
    "version": "4.0.0"
  },
  "host": "fin-statement-extractor.azurewebsites.net",
  "basePath": "/api",
  "schemes": ["https"],
  "produces": ["application/json"],
  "consumes": ["application/json"],
  "paths": {
    "/extract": {
      "post": {
        "operationId": "submitExtraction",
        "summary": "Submit a PDF for financial statement extraction",
        "description": "Uploads a PDF and starts extraction. Returns a jobId to poll for results.",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "name": "enrichment",
            "in": "query",
            "required": false,
            "type": "string",
            "default": "true",
            "enum": ["true", "false"],
            "x-ms-visibility": "internal"
          },
          {
            "name": "file",
            "in": "formData",
            "type": "file",
            "required": true,
            "description": "The PDF file to extract financial statements from"
          },
          {
            "name": "fileName",
            "in": "formData",
            "type": "string",
            "required": true,
            "description": "Original file name of the uploaded PDF"
          }
        ],
        "responses": {
          "202": {
            "description": "Extraction started",
            "schema": {
              "type": "object",
              "properties": {
                "jobId": {
                  "type": "string",
                  "description": "The job ID to poll for results"
                },
                "status": {
                  "type": "string",
                  "description": "Job status (processing)"
                }
              }
            }
          }
        }
      }
    },
    "/extract-by-url": {
      "post": {
        "operationId": "submitExtractionByUrl",
        "summary": "Submit a PDF URL for financial statement extraction",
        "description": "Accepts a direct download URL for a PDF and starts extraction. Use this for files that exceed the connector payload limit. Returns a jobId to poll for results.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["fileUrl", "fileName"],
              "properties": {
                "fileUrl": {
                  "type": "string",
                  "description": "Direct download URL for the PDF file"
                },
                "fileName": {
                  "type": "string",
                  "description": "Original file name of the PDF"
                },
                "authToken": {
                  "type": "string",
                  "description": "Optional Bearer token for authenticated URLs (e.g. Teams attachment URLs)"
                }
              }
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Extraction started",
            "schema": {
              "type": "object",
              "properties": {
                "jobId": {
                  "type": "string",
                  "description": "The job ID to poll for results"
                },
                "status": {
                  "type": "string",
                  "description": "Job status (processing)"
                }
              }
            }
          }
        }
      }
    },
    "/extract/status/{jobId}": {
      "get": {
        "operationId": "getExtractionStatus",
        "summary": "Poll for extraction results",
        "description": "Returns the current status and results of an extraction job.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The job ID from submitExtraction"
          }
        ],
        "responses": {
          "200": {
            "description": "Extraction status and results",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "description": "Job status: processing, completed, or failed"
                },
                "jobId": {
                  "type": "string",
                  "description": "The job ID, used by HITL review API endpoints"
                },
                "companyName": {
                  "type": "string",
                  "description": "Company name extracted from the report"
                },
                "summary": {
                  "type": "string",
                  "description": "JSON string with extraction summary"
                },
                "balanceSheet": {
                  "type": "string",
                  "description": "JSON string with Balance Sheet data (v1.2 schema)"
                },
                "incomeStatement": {
                  "type": "string",
                  "description": "JSON string with Income Statement data (v1.2 schema)"
                },
                "cashFlow": {
                  "type": "string",
                  "description": "JSON string with Cash Flow Statement data (v1.2 schema)"
                },
                "confidence": {
                  "type": "string",
                  "description": "JSON string with per-statement confidence scores"
                }
              }
            }
          }
        }
      }
    },
    "/build-review-card": {
      "post": {
        "operationId": "buildReviewCard",
        "summary": "Build an Adaptive Card for HITL statement review",
        "description": "Generates an Adaptive Card JSON payload. On first call (empty sessionState) returns the navigator card and initialises session state. On subsequent calls uses session state to determine which statement card to build.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["jobId"],
              "properties": {
                "jobId": {
                  "type": "string",
                  "description": "The extraction job ID"
                },
                "sessionState": {
                  "type": "string",
                  "description": "Opaque session state JSON string (empty on first call)",
                  "x-ms-visibility": "internal"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Adaptive Card JSON and session state",
            "schema": {
              "type": "object",
              "properties": {
                "cardJson": {
                  "type": "string",
                  "description": "The Adaptive Card JSON payload to display"
                },
                "sessionState": {
                  "type": "string",
                  "description": "Updated session state to pass back on next call"
                }
              }
            }
          }
        }
      }
    },
    "/parse-card-submission": {
      "post": {
        "operationId": "parseCardSubmission",
        "summary": "Parse an Adaptive Card submission and advance review state",
        "description": "Parses the Adaptive Card submit payload, diffs corrections, advances the session state machine, and returns a topic-facing action (continue/done/skip).",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["sessionState", "payload"],
              "properties": {
                "sessionState": {
                  "type": "string",
                  "description": "Current session state JSON string",
                  "x-ms-visibility": "internal"
                },
                "payload": {
                  "type": "string",
                  "description": "The raw Adaptive Card submission payload as a JSON string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Topic-facing action and updated session state",
            "schema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "description": "Topic action: continue, done, or skip"
                },
                "sessionState": {
                  "type": "string",
                  "description": "Updated session state to pass back"
                }
              }
            }
          }
        }
      }
    },
    "/apply-corrections": {
      "post": {
        "operationId": "applyCorrections",
        "summary": "Apply analyst corrections and return final data",
        "description": "Applies all accumulated corrections from session state to the cached extraction result. Returns corrected statement JSONs ready for Excel generation.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["jobId", "sessionState"],
              "properties": {
                "jobId": {
                  "type": "string",
                  "description": "The extraction job ID"
                },
                "sessionState": {
                  "type": "string",
                  "description": "Session state containing accumulated corrections",
                  "x-ms-visibility": "internal"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Corrected extraction data",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "description": "Always 'corrected'"
                },
                "companyName": {
                  "type": "string",
                  "description": "Company name"
                },
                "summary": {
                  "type": "string",
                  "description": "JSON string with extraction summary"
                },
                "balanceSheet": {
                  "type": "string",
                  "description": "JSON string with corrected Balance Sheet data"
                },
                "incomeStatement": {
                  "type": "string",
                  "description": "JSON string with corrected Income Statement data"
                },
                "cashFlow": {
                  "type": "string",
                  "description": "JSON string with corrected Cash Flow Statement data"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Health check",
        "x-ms-visibility": "internal",
        "responses": {
          "200": {
            "description": "Healthy",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "version": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "in": "query",
      "name": "code"
    }
  },
  "security": [{ "api_key": [] }]
}
