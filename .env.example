# Copy this file to .env and fill in your values
# Do NOT commit .env to source control

# ----- Azure Content Understanding -----
AZURE_CU_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com/contentunderstanding/analyzers/prebuilt-layout:analyze?api-version=2024-12-01-preview
AZURE_CU_API_KEY=your-api-key-here

# ----- Azure OpenAI (required only when running with --llm) -----
# Endpoint: your Azure OpenAI resource URL (no trailing slash)
AZURE_OPENAI_ENDPOINT=https://your-aoai-resource.openai.azure.com
# API key for the Azure OpenAI resource
AZURE_OPENAI_KEY=your-aoai-key-here
# Deployment name (model) to use — gpt-4o-mini recommended for cost efficiency
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# API version — leave as-is unless you need a newer preview version
AZURE_OPENAI_API_VERSION=2024-02-01
